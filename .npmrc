# GitHub Packages configuration for @osati-ai scope
@osati-ai:registry=https://npm.pkg.github.com

# GitHub Packages authentication
# Set GITHUB_TOKEN environment variable with a token that has write:packages scope
//npm.pkg.github.com/:_authToken=${GITHUB_TOKEN}

# Optional: Use GitHub Packages for all @osati-ai scoped packages
# This ensures any future @osati-ai packages also use GitHub Packages
